    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@onecms/eslint-config": "workspace:^",
    "@onecms/typescript-config": "workspace:^",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.2.0",
    "@types/supertest": "^7.2.1",
    "pino-pretty": "^13.1.3",
    "supertest": "^7.2.2",
    "tsx": "^4.23.12",
    "vitest": "^4.1.10"
  }
