{
  "name": "@onecms/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "test": "vitest run --fileParallelism=false",
    "migrate": "tsx scripts/migrate-to-tenants.ts",
    "seed:rbac": "cross-env DOTENV_CONFIG_PATH=../../.env node -r dotenv/config node_modules/tsx/dist/cli.mjs scripts/seed-rbac.ts",
    "check-types": "tsc --noEmit",
    "lint": "biome check .",
    "clean": "rm -rf .turbo node_modules"
  },
  "dependencies": {
    "mongoose": "^8.24.3"
  },
  "devDependencies": {
    "@onecms/typescript-config": "workspace:*",
    "@types/node": "^24.10.1",
    "mongodb-memory-server": "^11.2.0",
    "tsx": "^4.23.12",
    "typescript": "5.9.2",
    "vitest": "^4.1.10"
  }
}
