# oneCMS Environment Variables
# Copy this file to `.env` at the repo root and fill in real values.
# DO NOT commit the `.env` file — it is git-ignored.

# === Core ===
PORT=3001
NODE_ENV=development

# === Database (MongoDB) ===
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>

# === Redis (BullMQ job queue) ===
REDIS_HOST=localhost
REDIS_PORT=6379

# === AWS S3 (Media uploads) ===
AWS_ACCESS_KEY_ID=your_access_key_here
AWS_SECRET_ACCESS_KEY=your_secret_key_here
AWS_REGION=us-east-1
AWS_S3_BUCKET_NAME=onecms-media-bucket

# === AI Providers ===
OPENAI_API_KEY=sk-proj-your-openai-key
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key

# === SMTP (Transactional email) ===
SMTP_USER=you@example.com
SMTP_PORT=465
SMTP_PASSWORD=your_app_password_here
SMTP_SERVICE=gmail
SMTP_HOST=smtp.gmail.com

# === Payments (Stripe) ===
STRIPE_SECRET_KEY=sk_test_your_stripe_secret
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable

# === Authentication Secrets ===
# Generate secure secrets via: openssl rand -base64 32
JWT_SECRET=generate_a_random_secret_here
REFRESH_SECRET=generate_a_random_secret_here
JWT_PRIVATE_KEY=generate_a_random_private_key_here
JWT_PUBLIC_KEY=generate_a_random_public_key_here

# === OAuth (optional) ===
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
